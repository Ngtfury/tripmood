# Supabase Backend Configuration
# Paste your Supabase project URL and anon/public key below to enable multi-device live sync.
# (If left empty, the application runs in local offline-first mode automatically)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
